{
  "manifest_version": 3,
  "name": "Matchup for YouTube TV",
  "version": "0.1.0",
  "description": "Your Sleeper matchup beside YouTube TV. Personal prototype.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.sleeper.app/*",
    "https://api.sleeper.com/*",
    "https://site.web.api.espn.com/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://tv.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "114",
  "options_page": "options.html",
  "action": {
    "default_title": "Matchup settings"
  }
}
